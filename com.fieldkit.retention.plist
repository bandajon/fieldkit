<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- once keeps its compatibility acknowledgement; serving.lock makes overlap safe. -->
  <key>Label</key><string>com.fieldkit.retention</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/admin/fieldkit/.venv/bin/python</string>
    <string>/Users/admin/fieldkit/retention_maintenance.py</string>
    <string>once</string><string>--dataset</string><string>/Users/admin/fieldkit/dataset</string><string>--quiesced</string>
  </array>
  <!-- Daily, not hourly: apply holds loop.lock through a full ~700k-object cloud listing (5+ min
       on the office link), which starves classify, and the retention window is 7 days. -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>15</integer></dict>
  <key>WorkingDirectory</key><string>/Users/admin/fieldkit</string>
  <key>StandardOutPath</key><string>/dev/null</string>
  <key>StandardErrorPath</key><string>/Users/admin/fieldkit/output/retention.err</string>
</dict>
</plist>
